# Copy to ./secrets/snow.properties (mounted read-only into the Connect worker at /secrets)
# and reference values from connector JSON as ${file:/secrets/snow.properties:<key>}.
# Basic auth (snow.auth.type=basic)
username=kafka_integration
password=CHANGE_ME
# OAuth 2.0 client credentials (snow.auth.type=oauth2, snow.oauth.grant.type=client_credentials)
client.id=CHANGE_ME
client.secret=CHANGE_ME
