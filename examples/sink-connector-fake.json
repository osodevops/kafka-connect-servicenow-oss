{
  "name": "servicenow-sink-fake",
  "config": {
    "connector.class": "sh.oso.servicenow.sink.ServiceNowSinkConnector",
    "tasks.max": "1",
    "topics": "incident-updates",
    "snow.url": "http://servicenow-fake:8090",
    "snow.auth.type": "basic",
    "snow.auth.username": "connect",
    "snow.auth.password": "secret",
    "snow.sink.table": "incident",
    "snow.sink.operation.mode": "key_value",
    "snow.sink.update.method": "PATCH",
    "snow.sink.reporter.bootstrap.servers": "kafka:19092",
    "snow.sink.reporter.success.topic": "servicenow-sink-fake-success",
    "snow.sink.reporter.error.topic": "servicenow-sink-fake-errors",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-servicenow-sink-fake",
    "errors.deadletterqueue.topic.replication.factor": "1"
  }
}
