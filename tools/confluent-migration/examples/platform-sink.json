{
  "name": "servicenow-incident-sink",
  "config": {
    "connector.class": "io.confluent.connect.servicenow.ServiceNowSinkConnector",
    "tasks.max": "2",
    "topics": "incident-updates",
    "servicenow.url": "https://acme.service-now.com",
    "servicenow.user": "kafka_integration",
    "servicenow.password": "CHANGE_ME",
    "servicenow.table": "incident",
    "proxy.url": "",
    "servicenow.ssl.keystore.path": "/etc/pki/client.p12",
    "servicenow.ssl.keystore.password": "CHANGE_ME",
    "reporter.bootstrap.servers": "kafka:9092",
    "reporter.result.topic.name": "${connector}-success",
    "reporter.result.topic.replication.factor": "1",
    "reporter.result.topic.partitions": "1",
    "reporter.error.topic.name": "${connector}-error",
    "reporter.error.topic.replication.factor": "1",
    "reporter.error.topic.partitions": "1",
    "reporter.result.topic.value.format": "json",
    "reporter.producer.security.protocol": "SASL_SSL",
    "reporter.producer.sasl.mechanism": "PLAIN",
    "reporter.admin.security.protocol": "SASL_SSL",
    "confluent.topic.bootstrap.servers": "kafka:9092",
    "confluent.topic.replication.factor": "1",
    "confluent.license": "",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-servicenow-incident-sink",
    "errors.deadletterqueue.topic.replication.factor": "1"
  }
}
