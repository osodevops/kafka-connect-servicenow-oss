{
  "name": "ServiceNowSourceV2_0",
  "config": {
    "connector.class": "ServiceNowSourceV2",
    "name": "ServiceNowSourceV2_0",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "CHANGE_ME",
    "kafka.api.secret": "CHANGE_ME",
    "output.data.format": "JSON_SR",
    "schema.context.name": "default",
    "servicenow.url": "https://acme.service-now.com",
    "auth.type": "OAUTH2",
    "oauth2.token.url": "https://acme.service-now.com/oauth_token.do",
    "oauth2.client.id": "CHANGE_ME",
    "oauth2.client.secret": "CHANGE_ME",
    "oauth2.token.property": "access_token",
    "oauth2.client.scope": "any",
    "oauth2.client.auth.mode": "header",
    "servicenow.ssl.enabled": "false",
    "tables.num": "2",
    "table1.name": "incident",
    "table1.topic": "servicenow.incident",
    "table1.batch.size": "5000",
    "table1.start.timestamp": "2026-01-01 00:00:00",
    "table1.timestamp.field": "sys_updated_on",
    "table1.pagination.query": "active=true^priority<=2",
    "table1.pagination.query.field": "",
    "table1.request.parameters.separator": "&",
    "table1.display.value": "false",
    "table1.allowlisted.fields": "sys_id,sys_updated_on,number,short_description,state",
    "table1.request.interval.ms": "2000",
    "table1.exclude.reference.link": "true",
    "table1.query.category": "",
    "table1.count.records": "false",
    "table1.query.domain": "true",
    "table1.suppress.pagination.header": "true",
    "table2.name": "change_request",
    "table2.topic": "servicenow.change_request",
    "table2.batch.size": "20000",
    "table2.start.timestamp": "2026-01-01 00:00:00",
    "table2.timestamp.field": "sys_created_on",
    "table2.pagination.query": "sys_created_on>${offset}^ORDERBYsys_created_on",
    "table2.pagination.query.field": "sys_created_on",
    "table2.request.interval.ms": "5000",
    "max.retries": "3",
    "retry.backoff.policy": "EXPONENTIAL_WITH_JITTER",
    "retry.backoff.ms": "3000",
    "retry.on.status.codes": "400-",
    "behavior.on.error": "FAIL",
    "errors.tolerance": "none",
    "reporter.error.topic.name": "error-${connector}",
    "tasks.max": "2",
    "auto.restart.on.user.error": "true"
  }
}
